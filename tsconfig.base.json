{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@sentinel/core": ["packages/core/src/index.ts"],
      "@sentinel/core/*": ["packages/core/src/*"],
      "@sentinel/analyzer": ["packages/analyzer/src/index.ts"],
      "@sentinel/analyzer/*": ["packages/analyzer/src/*"],
      "@sentinel/vault": ["packages/vault/src/index.ts"],
      "@sentinel/vault/*": ["packages/vault/src/*"],
      "@sentinel/guardian": ["packages/guardian/src/index.ts"],
      "@sentinel/guardian/*": ["packages/guardian/src/*"],
      "@sentinel/llm": ["packages/llm/src/index.ts"],
      "@sentinel/llm/*": ["packages/llm/src/*"],
      "@sentinel/cli": ["packages/cli/src/index.ts"],
      "@sentinel/extension": ["packages/extension/src/extension.ts"],
      "@sentinel/webview": ["packages/webview/src/index.tsx"]
    }
  }
}
